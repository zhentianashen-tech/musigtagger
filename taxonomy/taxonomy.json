{
  "schema_version": 1,
  "id": "music-tagger-taxonomy",
  "version": "1.0.0",
  "status": "frozen",
  "released": "2026-11-17",
  "supersedes": "0.1.0-draft",
  "frozen_by": "MUSI-5 (human decisions recorded on MUSI-2)",
  "label_policy": {
    "canonical_label": "The canonical display label of a tag is its `labels[native_language]` entry.",
    "default_native_language": "en",
    "competing_terms": "native-original-canonical",
    "competing_terms_rule": "Where competing terms for the same concept exist in different languages, the term originating in the concept's own language or culture is canonical. Competing terms in other languages are recorded as aliases (normalization inputs) or display-only label variants -- never as separate tags.",
    "worked_example": "hip-hop is canonical for its concept (human decision, MUSI-2, 2026-11-17); the competing English term 'rap' is an alias of genre/hip-hop, not a tag.",
    "label_variants": "Optional per-language display strings in `labels`. They are display-only: they do not create tag identity and are not matched during ingestion normalization (use `aliases` for that).",
    "aliases_stored_off_track": "Aliases live only in this file. They are never stored on tracks; ingestion normalizes every alias to its canonical tag id at write time.",
    "unmapped_inputs": "Metadata that matches no tag id or alias is not dropped and not auto-invented: it surfaces as an unmapped value for human review. This file does not define the review queue (application-layer concern)."
  },
  "naming_rules": {
    "tag_id_pattern": "<facet-key>/<slug>",
    "slug_pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "slug_charset": "Lowercase ASCII letters, digits, internal hyphens. Spaces become hyphens. No other punctuation, no leading/trailing hyphen.",
    "case_policy": "Canonical slugs are lowercase; display labels use natural casing per language.",
    "number_policy": "Singular nouns (symphony, not symphonies); decade eras carry the trailing 's' (era/1980s).",
    "personal_exception": "personal/<user-slug> is user free-form: any characters except the '/' separator, at most 40 characters after the prefix. Exempt from slug rules and from the near-duplicate gates.",
    "language_value_pattern": "^origin/language:[a-z]{3}$",
    "language_value_charset": "ISO 639-3 three-letter lowercase code. Language values are generated per scheme, not enumerated in `tags`; consumers validate them against this pattern.",
    "near_duplicate_rejection": [
      "Differs from an existing tag only by pluralization, hyphen-vs-space, or casing.",
      "Is a typo-distance variant of an existing tag (reviewer judgment in v0/v1).",
      "Is already covered by an alias mapping.",
      "Duplicates, across facets, a meaning another facet already owns (mood:dark and genre:dark-ambient coexist; two facets may not both contain 'chill')."
    ],
    "minimum_specificity": "A proposed tag that is decomposable into an existing tag plus a modifier expressible as a personal/ tag is rejected (e.g. no 'sad-summer'; use mood/melancholy + personal/summer).",
    "broad_before_narrow": "Apply the broadest tag that is true. A child tag is only applied alongside its parent chain; parents are imputed at query time, not stored separately.",
    "parent_imputation": "query-time",
    "parent_imputation_note": "Storing genre/progressive-rock implies genre/rock for browsing and filtering without storing the parent. Stored tags stay minimal and re-parenting stays cheap."
  },
  "versioning_policy": {
    "scheme": "MAJOR.MINOR.PATCH",
    "current_version_bump_class": "1.x -- MINOR and PATCH are additive/backward-compatible; MAJOR breaks stored data.",
    "bump_rules": [
      {"change": "Add a canonical tag to an existing facet", "bump": "PATCH"},
      {"change": "Add an alias or a display label variant", "bump": "PATCH"},
      {"change": "Re-parent a node within its root family", "bump": "MINOR"},
      {"change": "Add a facet", "bump": "MINOR"},
      {"change": "Relax a cardinality or depth constraint", "bump": "MINOR"},
      {"change": "Rename, remove, or merge canonical tags", "bump": "MAJOR"},
      {"change": "Re-parent a node out of its root family", "bump": "MAJOR"},
      {"change": "Tighten a cardinality or depth constraint", "bump": "MAJOR"}
    ],
    "pinning_requirement": "Consumers must pin the loaded taxonomy version and refuse to run against versions outside their supported set. Stores that intend trustworthy migrations must record the taxonomy version in force at write time (requirement routed to the contracts spec, MUSI-6)."
  },
  "facets": [
    {
      "key": "genre",
      "question": "What kind of music is this?",
      "structure": "tree",
      "depth_cap": 2,
      "single_parent": true,
      "open_set": false,
      "cardinality": {"min": 1, "max": 3},
      "cardinality_note": "One primary genre; more than 3 signals a taxonomy gap, not a labeling problem.",
      "phase1_availability": "partial",
      "phase1_note": "Richest metadata source (ID3 TCON / Vorbis GENRE) but wildly inconsistent; normalizer + review queue do the heavy lifting.",
      "phase2_outlook": "Audio classifiers suggest into the same tags; only the source changes.",
      "phase3_outlook": "Network metadata lookup strengthens coverage on poorly-tagged files."
    },
    {
      "key": "mood",
      "question": "How does it feel?",
      "structure": "flat",
      "depth_cap": 0,
      "open_set": false,
      "cardinality": {"min": 0, "max": 4},
      "cardinality_note": "Moods co-occur; 0 is normal under Phase 1 because no metadata source expresses mood.",
      "phase1_availability": "none",
      "phase1_note": "Empty under metadata-only operation; UI must present it as available-but-unfilled, never broken.",
      "phase2_outlook": "Primary Phase-2 win: valence/energy proxies suggest, human confirms.",
      "phase3_outlook": "Streaming-service mood tags could seed suggestions."
    },
    {
      "key": "era",
      "question": "When is it from?",
      "structure": "flat",
      "depth_cap": 0,
      "open_set": false,
      "cardinality": {"min": 0, "max": 1},
      "cardinality_note": "Derived from release date when present; absent date means no era tag.",
      "derived_from": "release_date",
      "phase1_availability": "full",
      "phase1_note": "Near-fully derivable from TDRC/DATE/YEAR with filename-year fallback. Lowest-risk facet; first end-to-end vertical slice candidate.",
      "phase2_outlook": "Audio adds nothing needed.",
      "phase3_outlook": "Network lookup fills dates for untagged files."
    },
    {
      "key": "activity",
      "question": "What is it good for?",
      "structure": "flat",
      "depth_cap": 0,
      "open_set": false,
      "cardinality": {"min": 0, "max": 3},
      "cardinality_note": "Often none -- that is valid.",
      "phase1_availability": "none",
      "phase1_note": "No metadata source expresses it; purely human-curated in Phase 1, which matches the moment users build activity playlists.",
      "phase2_outlook": "Weak suggestions possible (tempo/energy -> workout, stability -> focus); human curation stays primary.",
      "phase3_outlook": "Little direct network benefit."
    },
    {
      "key": "origin",
      "question": "Where / what tradition is it from?",
      "structure": "tree",
      "depth_cap": 2,
      "single_parent": true,
      "open_set": false,
      "cardinality": {"min": 0, "max": 2},
      "language_cardinality": {"min": 0, "max": 2},
      "language_values": {
        "scheme": "origin/language:<iso-639-3>",
        "enumerated": false,
        "note": "Language values are scheme-generated, not enumerated tags; validate against naming_rules.language_value_pattern. Flagged to MUSI-6: the loader must accept scheme-valid language ids in addition to enumerated tags."
      },
      "phase1_availability": "partial",
      "phase1_note": "Locale/country frames and label (TPUB) give weak hints; lyrics language is absent. Often sparse.",
      "phase2_outlook": "Audio barely helps origin.",
      "phase3_outlook": "Primary Phase-3 beneficiary: network metadata lookup."
    },
    {
      "key": "personal",
      "question": "The user's own organizational tags.",
      "structure": "open",
      "depth_cap": 0,
      "open_set": true,
      "cardinality": {"min": 0, "max": null},
      "id_prefix": "personal/",
      "phase1_availability": "full",
      "phase1_note": "Human-supplied by definition. This is the facet that makes metadata-only Phase 1 a viable product, not a degraded mode.",
      "phase2_outlook": "Unchanged.",
      "phase3_outlook": "Unchanged."
    }
  ],
