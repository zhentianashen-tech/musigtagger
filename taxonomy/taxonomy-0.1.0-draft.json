      "hierarchy": false,
      "max_depth": 1,
      "open_set": false
    },
    {
      "id": "era",
      "label": "Era",
      "description": "Decade the music is from. Closed, machine-generable set.",
      "phase1_available": true,
      "hierarchy": false,
      "max_depth": 1,
      "open_set": false
    },
    {
      "id": "activity",
      "label": "Activity",
      "description": "What the music is good for. Flat; human-curated in Phase 1.",
      "phase1_available": false,
      "hierarchy": false,
      "max_depth": 1,
      "open_set": false
    },
    {
      "id": "origin",
      "label": "Origin",
      "description": "Region/culture plus language tags (origin.lang-*). Shallow tree.",
      "phase1_available": true,
      "hierarchy": true,
      "max_depth": 2,
      "open_set": false
    },
    {
      "id": "personal",
